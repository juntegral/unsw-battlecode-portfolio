+// ---- cand-portal5: shared portal knowledge ----
+void World::notePair(int t1, int s1, int t2, int s2, uint8_t trap) {
+    for (auto& n : news) {
+        if ((n.t1 == t1 && n.s1 == s1 && n.t2 == t2 && n.s2 == s2) || (n.t1 == t2 && n.s1 == s2 && n.t2 == t1 && n.s2 == s1)) {
+            if (n.t1 == t1) n.trap |= trap;
+            else n.trap |= (uint8_t)(((trap & 3) << 2) | ((trap >> 2) & 3));
+            return;
+        }
+    }
+    if (news.size() < 32) news.push_back(PortalNews{t1, s1, t2, s2, trap});
+}
+
+void World::markTrap(int t, int d) {
+    trapEntry[(size_t)t * 4 + d] = 1;
+    int side; int ct = canonicalPortalEnd(t, d, side);
+    int bit = (d == side) ? 0 : 1; // moving N/W from the canonical tile, or back across it from the neighbour
+    for (auto& n : news) {
+        if (n.t1 == ct && n.s1 == side) n.trap |= (uint8_t)(1 << bit);
+        else if (n.t2 == ct && n.s2 == side) n.trap |= (uint8_t)(1 << (bit + 2));
+    }
+}
+
+void World::learnPair(const PortalNews& n) {
+    auto edgeId = [&](int t, int s) -> int { const Tile& x = tiles[t]; return x.edge[s] == EDGE_PORTAL ? x.portal[s] : (x.edge[s] == EDGE_UNKNOWN ? -1 : -9); };
+    int p1 = edgeId(n.t1, n.s1), p2 = edgeId(n.t2, n.s2);
+    if (p1 == -9 || p2 == -9) return; // we saw open water or kelp there: not our map's pair
+    int pid = (p1 >= 0 && p1 < 1000) ? p1 : ((p2 >= 0 && p2 < 1000) ? p2 : 2000 + n.t1 * 2 + (n.s1 == W ? 1 : 0));
+    auto& ends = portals[pid];
+    auto addEnd = [&](int t, int s) {
+        for (auto& e : ends) if (e.t == t && e.side == s) return;
+        if (ends.size() < 2) ends.push_back(PortalEnd{t, s});
+    };
+    addEnd(n.t1, n.s1); addEnd(n.t2, n.s2);
+    { int have = 0; for (auto& e : ends) if ((e.t == n.t1 && e.side == n.s1) || (e.t == n.t2 && e.side == n.s2)) have++;
+      if (have < 2) return; } // it does not fit what we know: ignore it
+    auto mark = [&](int t, int s) {
+        Tile& a = tiles[t];
+        if (a.edge[s] == EDGE_PORTAL && a.portal[s] >= 0 && a.portal[s] < 1000) return; // seen with its real id
+        a.edge[s] = EDGE_PORTAL; a.portal[s] = (int16_t)pid;
+        int u = geo.stepIdx(t, s); tiles[u].edge[opp(s)] = EDGE_PORTAL; tiles[u].portal[opp(s)] = (int16_t)pid;
+    };
+    mark(n.t1, n.s1); mark(n.t2, n.s2);
+    if (n.trap & 1) trapEntry[(size_t)n.t1 * 4 + n.s1] = 1;
+    if (n.trap & 2) trapEntry[(size_t)geo.stepIdx(n.t1, n.s1) * 4 + opp(n.s1)] = 1;
+    if (n.trap & 4) trapEntry[(size_t)n.t2 * 4 + n.s2] = 1;
+    if (n.trap & 8) trapEntry[(size_t)geo.stepIdx(n.t2, n.s2) * 4 + opp(n.s2)] = 1;
+    notePair(n.t1, n.s1, n.t2, n.s2, n.trap); // pass it on
+}
