+// cand-portal5: [magic 6][x1 6][y1 6][s1 1][x2 6][y2 6][s2 1][trap 4][team 1][check 8], whitened like the others
+static const uint64_t MSG_MAGIC_PORTAL = 0x15;
+static uint64_t portalCheck(uint64_t x1, uint64_t y1, uint64_t s1, uint64_t x2, uint64_t y2, uint64_t s2, uint64_t tr, uint64_t team) {
+    return (x1 * 7 + y1 * 13 + s1 * 29 + x2 * 37 + y2 * 41 + s2 * 53 + tr * 61 + team * 101 + 0x5C) & 255;
+}
+uint64_t World::encodePortalMsg(const PortalNews& n) const {
+    uint64_t x1 = (uint64_t)(n.t1 % geo.W) & 63, y1 = (uint64_t)(n.t1 / geo.W) & 63, s1 = n.s1 == W ? 1 : 0;
+    uint64_t x2 = (uint64_t)(n.t2 % geo.W) & 63, y2 = (uint64_t)(n.t2 / geo.W) & 63, s2 = n.s2 == W ? 1 : 0;
+    uint64_t tr = n.trap & 15, team = myTeam == 'B' ? 1 : 0;
+    uint64_t v = (MSG_MAGIC_PORTAL << 58) | (x1 << 52) | (y1 << 46) | (s1 << 45) | (x2 << 39) | (y2 << 33) | (s2 << 32) |
+                 (tr << 28) | (team << 27) | (portalCheck(x1, y1, s1, x2, y2, s2, tr, team) << 19);
+    return v ^ MSG_WHITEN;
+}
+bool World::decodePortalMsg(uint64_t v, PortalNews& out) const {
+    v ^= MSG_WHITEN;
+    if ((v >> 58) != MSG_MAGIC_PORTAL) return false;
+    uint64_t x1 = (v >> 52) & 63, y1 = (v >> 46) & 63, s1 = (v >> 45) & 1, x2 = (v >> 39) & 63, y2 = (v >> 33) & 63, s2 = (v >> 32) & 1;
+    uint64_t tr = (v >> 28) & 15, team = (v >> 27) & 1, chk = (v >> 19) & 255;
+    if (chk != portalCheck(x1, y1, s1, x2, y2, s2, tr, team) || (v & 0x7FFFF) != 0) return false;
+    if ((team == 1) != (myTeam == 'B')) return false;
+    if ((int)x1 >= geo.W || (int)y1 >= geo.H || (int)x2 >= geo.W || (int)y2 >= geo.H) return false;
+    out.t1 = geo.idx((int)x1, (int)y1); out.s1 = s1 ? W : N; out.t2 = geo.idx((int)x2, (int)y2); out.s2 = s2 ? W : N; out.trap = (uint8_t)tr;
+    return !(out.t1 == out.t2 && out.s1 == out.s2);
 }
 
