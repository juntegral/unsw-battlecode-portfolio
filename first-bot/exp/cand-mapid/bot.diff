-    int splitSize = 0; bool frag = false;
-    if (!cands[best].trade && !cands[best].blind && (wantSplit(splitSize) || (frag = wantFrag(splitSize)))) {
+    // (cand-mapid: or an early split on Schooltime b, tagged " bsp")
+    int splitSize = 0; bool frag = false, bsplit = false;
+    if (!cands[best].trade && !cands[best].blind && (wantSplit(splitSize) || (frag = wantFrag(splitSize)) || (bsplit = wantBSplit(splitSize)))) {
         double immediate = cands[best].tiles.empty() ? 0.0 : SC.pnow[cands[best].tiles[0]];
         bool threatened = false; for (int t : cands[best].tiles) if (threatAt(t) > 0.0) threatened = true;
         if (immediate < 0.5 && !threatened && safety[best] > -1.0 && enemyDist_[w_.headT] > 2) {
             act.kind = Action::SPLIT; act.splitSize = splitSize;
             if (frag) lastFragRound_ = w_.round;
             setSonar(act);
-            char buf[64]; snprintf(buf, sizeof buf, "split%d u%d L%d%s", splitSize, w_.unitCount, w_.myLen, frag ? " frag" : "");
+            char buf[64]; snprintf(buf, sizeof buf, "split%d u%d L%d%s", splitSize, w_.unitCount, w_.myLen, frag ? " frag" : bsplit ? " bsp" : "");
             act.indicator = buf;
             return act;
