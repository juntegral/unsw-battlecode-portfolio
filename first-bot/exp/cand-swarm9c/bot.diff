+// cand-swarm9: a head-on kills both dragons, and vision does not cross portals. Our own heads crowd around portals once
+// the swarm is out, so an ally head that could stand on the exit tile when we step in makes the crossing dear. Info of
+// age a rounds (seen or heard over sonar): the ally may have moved up to a+1 tiles since. Allies in view now are exact.
+bool Planner::allyInViewNow(int id) const {
+    for (int a : w_.allyHeadsNow) if (a == id) return true;
+    return false;
+}
+
+double Planner::allyExitPenalty(int to) const {
+    double pen = 0.0;
+    for (auto& [id, dg] : w_.dragons) {
+        if (id == w_.myId || id == (w_.myId & 255) || dg.team != w_.myTeam || dg.headT < 0) continue;
+        int age = w_.round - dg.headSeen;
+        if (age < 0 || age > P::ALLY_EXIT_AGE || allyInViewNow(id)) continue;
+        int md = w_.geo.manhattan(dg.headT, to);
+        if (md == 0 && age == 0) return P::ALLY_EXIT_SURE_PENALTY;
+        if (md <= age + 1) pen = P::ALLY_EXIT_PENALTY;
+    }
+    return pen;
+}
+
+// cand-swarm9: an unexplored portal's exit lies on a tile we have never seen (had we seen it, we would know its portal id
+// and the pair). An ally head recently out of view on or near a never-seen tile may be standing on that exit.
+double Planner::allyBlindPenalty() const {
+    const int W = w_.geo.W;
+    for (auto& [id, dg] : w_.dragons) {
+        if (id == w_.myId || id == (w_.myId & 255) || dg.team != w_.myTeam || dg.headT < 0) continue;
+        int age = w_.round - dg.headSeen;
+        if (age < 0 || age > P::ALLY_EXIT_AGE || allyInViewNow(id)) continue;
+        int r = age + 1, hx = dg.headT % W, hy = dg.headT / W;
+        for (int dy = -r; dy <= r; dy++) {
+            int rx = r - (dy < 0 ? -dy : dy);
+            for (int dx = -rx; dx <= rx; dx++) {
+                int u = w_.geo.idx(w_.geo.wrapX(hx + dx), w_.geo.wrapY(hy + dy));
+                if (w_.tiles[u].seen < 0) return P::ALLY_BLIND_PENALTY;
+            }
+        }
+    }
+    return 0.0;
+}
