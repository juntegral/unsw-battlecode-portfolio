 constexpr double PORTAL_UNPROBED_PENALTY = 4.0;  // known portal, exit out of view, no probe from here last turn
 constexpr double PORTAL_DIRTY_PENALTY = 8.0;     // known portal, exit out of view, last turn's probe hit a dragon
+
+// --- cand-portal2: frustration. A pearl we keep seeing but never take (a pocket our length cannot turn in, a dead end
+// the safety check refuses) stops pulling, so a dragon beyond a portal does not circle it for the rest of the game.
+constexpr int    FRUST_GRACE = 12;           // turns a pearl may stay in view uneaten before its pull fades
+constexpr int    FRUST_SPAN = 24;            // turns over which the pull fades to FRUST_FLOOR
+constexpr double FRUST_FLOOR = 0.1;
 constexpr double DOOM_VALUE = -200.0;        // below this the best move is death within the horizon
 
